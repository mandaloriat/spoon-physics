# Local configuration. `.env.example` is the tracked one; `.env` holds a real domain and
# is per-machine. Nothing secret belongs in either — the lab has no credentials.
.env

# Built Fenix Spoon widgets. Generated by scripts/fetch-widgets.sh from the pinned commit
# and by the Docker build's node stage, so they are reproducible rather than archived.
# Committing them would mean reviewing thousands of lines of someone else's build output
# on every dependency bump.
/frontend/vendor/

# The pinned Fenix Spoon checkout the fetch script makes.
/.fenix-spoon-src/

# Python
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Node
node_modules/
test-results/
playwright-report/

# Local job data, when running outside Docker
/.lab-data/

# Local scratch for screenshots and one-off scripts. Never committed.
.scratch/

# The Python lock file. Generated locally by `uv sync` for a test run; the project installs
# from `pyproject.toml` and does not pin a resolution, so a lock committed by accident would
# quietly become the resolution CI uses.
/uv.lock

# State for scripts/auto-deploy.sh on a server that polls: its lock, its log, and the
# revision that last failed to deploy. Per-machine by definition.
/.auto-deploy/
