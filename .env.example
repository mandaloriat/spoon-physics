# Spoon Physics — configuration.
#
#   cp .env.example .env
#
# Nothing here is secret and nothing here should become secret: the lab runs anonymously,
# has no accounts, no API keys and no third-party credentials. If you ever add one, put it
# in a file Docker reads as a secret rather than in this one.
#
# Every FENIXSPOON_* variable is read by Fenix Spoon itself; the names and defaults below
# were checked against the pinned commit, not against its README.


# ═══════════════════════════════════════════════════════════ domain and reverse proxy

# The hostname Caddy will obtain a certificate for. Must already resolve to this server —
# see the DNS section of the README.
LAB_DOMAIN=lab.andolfatto.eu

# Address Let's Encrypt should send expiry warnings to. Setting it here is not enough on
# its own: uncomment the `email` line in the Caddyfile too. Leave blank to go without.
LAB_ACME_EMAIL=

# Host port the development stack publishes, on 127.0.0.1 only. Production publishes
# nothing but Caddy's 80 and 443.
LAB_DEV_PORT=8000

# Which compose overlay scripts/deploy.sh adds to compose.yaml. Leave unset unless this
# box already runs a shared, host-level Caddy on 80/443 for multiple apps — in that case
# set this to compose.host-caddy.yaml, which publishes the api to 127.0.0.1 instead of
# running a second Caddy container that would fight the host one for those ports.
LAB_COMPOSE_OVERLAY=compose.production.yaml


# ═══════════════════════════════════════════════════════════════ the pinned dependency
#
# All three values below describe the SAME Fenix Spoon commit, and scripts/check-pins.sh
# fails the build if they ever disagree. Upstream tagged v0.1.0, but it points three commits
# before the 3-D geometry kind this lab now uses, so a commit SHA is still the pin — see
# docs/architecture-decisions.md (ADR-007) for that reasoning and the upgrade procedure.

# The commit. Also pinned in pyproject.toml, which is what pip resolves.
FENIX_SPOON_COMMIT=3d483a38d619b3b6c2d88e798ca0be5420d5ef6d

# Base image with the mock solvers only, ~100 MB. Used by the development stack; enough
# for the whole protocol, both widgets and the airfoil experiment.
#   digest sha256:515834de44a656e345d57a9923517334ed3764e630ee10b44b86c7c90e2f61e6
FENIX_SPOON_IMAGE=ghcr.io/mandaloriat/fenix-spoon:sha-3d483a3-slim

# Base image with the full FEniCSx runtime (dolfinx v0.11.0), ~3 GB. Used by production
# for both the API and the workers.
#   digest sha256:58b368b7d64399a2070e72429db5f837bc03f0bb3a40dac4c13a24c01f05a07c
# Note: `:latest` and `:latest-slim` now DO exist in GHCR — the v0.1.0 tag created them —
# but they point at the release, which is a server without `regions3d` in it. They are not
# pins either way. Do not "fix" a pull failure by switching to them.
FENIX_SPOON_FENICS_IMAGE=ghcr.io/mandaloriat/fenix-spoon:sha-3d483a3

# Tags for the images this repository builds. Two, not one: they are built from different
# bases, and a shared tag would let a development build — mock solvers only — overwrite
# the image production then starts, whose only symptom would be a production site that
# quietly lost its FEniCSx mode.
LAB_IMAGE=physics-lab:prod
LAB_DEV_IMAGE=physics-lab:dev


# ═══════════════════════════════════════════════════════════════════════ the service

# Maintenance switch. Set to false to keep the site, the catalogue and every finished
# result online while refusing new solves — what to reach for when the box is busy or a
# solver is misbehaving. The pages show a banner instead of a Run button that would 503.
#   docker compose -f compose.yaml -f compose.production.yaml up -d --no-deps api
PHYSICS_LAB_JOBS_ENABLED=true


# ═════════════════════════════════════════════════════════ limits for a public demo
#
# The lab runs anonymously, so every visitor resolves to Fenix Spoon's `anonymous`
# principal and these quotas are effectively SERVER-WIDE rather than per person. That is
# the correct shape for capping total load and the wrong one for stopping one abusive
# client — see the "Abuse" section of the README, and the rate-limiting block at the
# bottom of the Caddyfile.

# Cells a single job may ask for, checked at submit from the solver's own estimate, so an
# over-sized request is refused with an explanation instead of being killed halfway
# through. 200,000 comfortably covers the airfoil at maximum resolution (~175,000).
FENIXSPOON_MAX_CELLS=200000

# Wall-clock seconds a solve may run. Cooperative: the solver is asked to stop at its next
# check point. Keep the Caddy proxy timeouts well above this.
FENIXSPOON_JOB_TIMEOUT=90

# Queued + running jobs at once, across the whole anonymous demo.
FENIXSPOON_MAX_CONCURRENT_JOBS=2

# Submissions per rolling hour, across the whole anonymous demo. At 100 this is roughly
# 100 solves an hour for every visitor combined — which is why the experiment page never
# solves automatically and only ever on an explicit click.
FENIXSPOON_MAX_JOBS_PER_HOUR=100

# Total stored artifact bytes before submissions are refused. 500 MB against a VTK file
# of a few hundred kB is thousands of results, well beyond what the TTL below keeps.
FENIXSPOON_MAX_ARTIFACT_BYTES=500000000


# ═══════════════════════════════════════════════════════════════════════ persistence

# How long a finished job's record, result payload and artifacts are kept, in seconds.
# 24 hours: long enough to share a link with someone, short enough that a public demo is
# not quietly accumulating a year of other people's simulations. Swept hourly and at
# startup. 0 would keep them forever — don't, on a public deployment.
FENIXSPOON_JOB_TTL=86400

# `sqlite` persists jobs under the data directory; `memory` loses them on restart.
FENIXSPOON_STORE=sqlite


# ══════════════════════════════════════════════════════════════ execution and workers

# Solves per worker container. Keep it at 1 and scale containers instead, so the memory
# limit applies to one job rather than several sharing it.
FENIXSPOON_WORKER_CONCURRENCY=1

# In-process solves, used only by the development stack. Production sets
# FENIXSPOON_REDIS_URL (in compose.production.yaml, not here) and the API stops solving
# entirely — that one variable switches both its execution backend and its event bus.
FENIXSPOON_MAX_WORKERS=2

# Container resource ceilings. The worker's memory limit is a real per-job ceiling, since
# one solve is one process there.
LAB_API_CPUS=1.0
LAB_API_MEMORY=768M
LAB_WORKER_CPUS=1.5
LAB_WORKER_MEMORY=2G


# ═══════════════════════════════════════════════════════════════════════════ browser

# Allowed cross-origin callers. The lab needs none: Caddy serves the pages and proxies the
# API under one hostname, so every request the browser makes is same-origin. Left set to
# the site's own origin so the value is a decision rather than an oversight.
FENIXSPOON_CORS_ORIGINS=https://lab.andolfatto.eu
